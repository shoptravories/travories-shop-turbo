ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
# Local Docker Redis: `docker compose up -d redis`
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Garage object storage (S3-compatible) for media uploads/downloads.
# Fill these in apps/backend/.env when credentials are ready.
# Example:
# S3_FILE_URL=https://cdn.example.com
# S3_ENDPOINT=https://garage.example.com
# S3_BUCKET=media
# S3_BUCKET_NAME_PUBLIC=media
# S3_REGION=garage
# S3_ACCESS_KEY_ID=your-access-key
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_SECRET_KEY=your-secret-key
#
# Used by:
#   - Medusa file module
#   - POST /admin/media/upload-url
#   - GET  /admin/media/download-url?key=...
#
# Leave blank to keep Medusa's default local-file provider.
S3_FILE_URL=
S3_ENDPOINT=
S3_BUCKET=
# Alias accepted by this repo if your provider uses that naming:
S3_BUCKET_NAME_PUBLIC=
# Garage ignores the region but the AWS SDK still requires one.
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_SECRET_KEY=

# eSewa ePay v2 checkout
# This repo currently integrates the hosted web checkout flow. Keep the real
# values in apps/backend/.env only.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_STOREFRONT_BASE_URL=http://localhost:8000
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_PATH=/api/payment-return/esewa
ESEWA_FAILURE_PATH=/api/payment-return/esewa
ESEWA_TAX_AMOUNT=0
ESEWA_PRODUCT_SERVICE_CHARGE=0
ESEWA_PRODUCT_DELIVERY_CHARGE=0

# Optional placeholders for future app-SDK / intent work.
ESEWA_CLIENT_ID=
ESEWA_CLIENT_SECRET=
ESEWA_INTENT_PRODUCT_CODE=INTENT
ESEWA_INTENT_CLIENT_SECRET=
