# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=

# Stripe publishable key for payment processing (optional, only if using Stripe)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Hostname of the S3-compatible media host. next/image and the Open Graph image
# renderer both refuse remote URLs from hosts that are not listed here.
NEXT_PUBLIC_MEDIA_HOSTNAME=

# Node environment (development, production, etc.)
NODE_ENV=

# --- SEO and social sharing (all optional) ---
# Handle used for twitter:site / twitter:creator and the "via" on share links.
# Omitted from the head entirely when unset - pointing a card at a handle that
# does not exist is worse than shipping no tag.
NEXT_PUBLIC_TWITTER_HANDLE=

# Profile URLs published in the Organization schema's sameAs graph.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Facebook app id for link insights (fb:app_id).
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Search Console / Pinterest domain verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_SITE_VERIFICATION=
